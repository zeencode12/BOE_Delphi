unit Unit1;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics,
  Controls, Forms, Dialogs, StdCtrls, Grids, ExtCtrls, DB, ADODB;

type
  TForm1 = class(TForm)
    PanelMenu: TPanel;
    PanelOrder: TPanel;
    imgCoffee: TImage;
    imgLatte: TImage;
    imgTea: TImage;
    imgCroissant: TImage;
    btnCoffee: TButton;
    btnLatte: TButton;
    btnTea: TButton;
    btnCroissant: TButton;
    StringGrid1: TStringGrid;
    edTotal: TEdit;
    edBayar: TEdit;
    edKembali: TEdit;
    btnSimpan: TButton;
    ADOConnection1: TADOConnection;
    ADOQuery1: TADOQuery;
    procedure FormCreate(Sender: TObject);
    procedure btnCoffeeClick(Sender: TObject);
    procedure btnLatteClick(Sender: TObject);
    procedure btnTeaClick(Sender: TObject);
    procedure btnCroissantClick(Sender: TObject);
    procedure edBayarChange(Sender: TObject);
    procedure btnSimpanClick(Sender: TObject);
  private
    procedure TambahItem(nama:string; harga:integer);
    procedure HitungTotal;
  public
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

procedure TForm1.FormCreate(Sender: TObject);
begin

StringGrid1.RowCount := 1;
StringGrid1.ColCount := 4;

StringGrid1.Cells[0,0] := 'Menu';
StringGrid1.Cells[1,0] := 'Harga';
StringGrid1.Cells[2,0] := 'Qty';
StringGrid1.Cells[3,0] := 'Subtotal';

imgCoffee.Picture.LoadFromFile(ExtractFilePath(Application.ExeName)+'images\coffee.png');
imgLatte.Picture.LoadFromFile(ExtractFilePath(Application.ExeName)+'images\latte.png');
imgTea.Picture.LoadFromFile(ExtractFilePath(Application.ExeName)+'images\tea.png');
imgCroissant.Picture.LoadFromFile(ExtractFilePath(Application.ExeName)+'images\croissant.png');

end;

procedure TForm1.TambahItem(nama:string; harga:integer);
var row:integer;
begin

row := StringGrid1.RowCount;
StringGrid1.RowCount := row + 1;

StringGrid1.Cells[0,row] := nama;
StringGrid1.Cells[1,row] := IntToStr(harga);
StringGrid1.Cells[2,row] := '1';
StringGrid1.Cells[3,row] := IntToStr(harga);

HitungTotal;

end;

procedure TForm1.HitungTotal;
var i,total:integer;
begin

total := 0;

for i := 1 to StringGrid1.RowCount-1 do
total := total + StrToIntDef(StringGrid1.Cells[3,i],0);

edTotal.Text := IntToStr(total);

end;

Procedure TForm1.btnCoffeeClick(Sender: TObject);
begin
TambahItem('Coffee',15000);
end;

procedure TForm1.btnLatteClick(Sender: TObject);
begin
TambahItem('Latte',20000);
end;

procedure TForm1.btnTeaClick(Sender: TObject);
begin
TambahItem('Tea',10000);
end;

procedure TForm1.btnCroissantClick(Sender: TObject);
begin
TambahItem('Croissant',18000);
end;

procedure TForm1.edBayarChange(Sender: TObject);
var bayar,total:integer;
begin
bayar := StrToIntDef(edBayar.Text,0);
total := StrToIntDef(edTotal.Text,0);
edKembali.Text := IntToStr(bayar-total);
end;

procedure TForm1.btnSimpanClick(Sender: TObject);
begin
ShowMessage('Transaksi disimpan (contoh). Hubungkan ke database untuk produksi.');
end;

end.